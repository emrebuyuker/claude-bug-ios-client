# ==========================================================================
# .env.prod — TestFlight / App Store environment
#
# Bu dosya `fastlane generate_testflight` + `fastlane publish_testflight`
# tarafından yüklenir. Gerçek değerleri `.env.prod` dosyasına kopyala
# ve doldur — `.env.prod` `.gitignore` içindedir.
# ==========================================================================

# --- App metadata ---
APP_NAME                    = ClaudeBug PoC

# --- XcodeGen ---
XCODEGEN_CONFIG_FILE        = testflight.yml

# --- Info.plist hedef yolu ---
INFO_PLIST                  = ClaudeBugPoC/Info.plist

# --- App Store Connect ---
APPSTORE_USERNAME           = your-apple-id@example.com

# --- GoogleService-Info.plist (production Firebase) ---
FIREBASE_CONFIG_FILE        = google-services-prod.plist
GOOGLE_SERVICES_PLIST       = ClaudeBugPoC/GoogleService-Info.plist
