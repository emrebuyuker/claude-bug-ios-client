# ==========================================================================
# .env.test — Firebase distribution (development) environment
#
# Bu dosya `fastlane generate_firebase` + `fastlane publish_firebase` tarafından
# Dotenv.overload ile yüklenir. Gerçek değerleri `.env.test` dosyasına kopyala
# ve doldur — `.env.test` `.gitignore` içindedir.
# ==========================================================================

# --- App metadata ---
APP_NAME                    = ClaudeBug PoC (Dev)

# --- XcodeGen ---
XCODEGEN_CONFIG_FILE        = firebase.yml

# --- Info.plist hedef yolu (update_info_plist için) ---
INFO_PLIST                  = ClaudeBugPoC/Info.plist

# --- Firebase App Distribution ---
# Firebase Console → Project Settings → General → "App ID"
FIREBASE_APP_TOKEN          = 1:634839679302:ios:5e6948b022a41902806547
FIREBASE_RELASE_NOTES       = Dev build
# Comma-separated email list, e.g. "tester1@example.com,tester2@example.com"
FIREBASE_TESTERS            =
# Firebase App Distribution tester groups (comma-separated)
FIREBASE_GROUPS             = internal-testers

# --- GoogleService-Info.plist kopyalama ---
# `generate_firebase` lane'i bu kaynağı GOOGLE_SERVICES_PLIST'e cat'ler
FIREBASE_CONFIG_FILE        = google-services-firebase.plist
GOOGLE_SERVICES_PLIST       = ClaudeBugPoC/GoogleService-Info.plist
